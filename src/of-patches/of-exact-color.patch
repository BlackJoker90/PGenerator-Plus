 //----------------------------------------------------------
+void ofGLProgrammableRenderer::setExactColor(float r, float g, float b, float a){
+	ofFloatColor newExact(pgClamp01(r),pgClamp01(g),pgClamp01(b),pgClamp01(a));
+	currentStyle.color = newExact; // 8 bit approximation for getStyle()
+	if(newExact!=pgExactColor){
+		pgExactColor = newExact;
+		if(currentShader){
+			currentShader->setUniform4f(COLOR_UNIFORM,pgExactColor.r,pgExactColor.g,pgExactColor.b,pgExactColor.a);
+		}
+	}
+}
+
+//----------------------------------------------------------
+void ofGLProgrammableRenderer::backgroundExact(float r, float g, float b, float a){
+	currentStyle.bgColor = ofFloatColor(pgClamp01(r),pgClamp01(g),pgClamp01(b),pgClamp01(a));
+	glClearColor(pgClamp01(r),pgClamp01(g),pgClamp01(b),pgClamp01(a));
+	glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+}
+
+//----------------------------------------------------------
 void ofGLProgrammableRenderer::setColor(int gray){
 	setColor(gray, gray, gray);
 }
