# Program: resize_PGenerator_disk
# Version: 1.0
#
#############################################
#           Check First Boot                #
#############################################
FIRST_BOOT_FILE="/etc/BiasiLinux/BiasiLinux.FirstBoot"
if [ ! -f "$FIRST_BOOT_FILE" ]; then
 echo -e "\nThis is not the First Boot, not executing\n"
 exit 0
fi

#############################################
#       Check if device is PGenerator       #
#############################################
BOOT_PARTITION=$(blkid -L BOOT_PG 2>/dev/null)
if [ "$BOOT_PARTITION" = "" ];then
 BOOT_PARTITION=$(blkid -L PGBOOT 2>/dev/null)
fi
ROOT_PARTITION=$(blkid -L /_PG 2>/dev/null)
if [ "$ROOT_PARTITION" = "" ];then
 ROOT_PARTITION=$(blkid -L __PG 2>/dev/null)
fi
if [ "$BOOT_PARTITION" = "" ] || [ "$ROOT_PARTITION" = "" ];then
 echo -e "\nThis device doesn't contain a PGenerator image, not executing\n"
 exit 0
fi

#############################################
#                 Variables                 #
#############################################
ROOT_PARTITION_PATTERN=$(echo $ROOT_PARTITION|sed -e "s/\//\\\\\//g")
DISK=$(lsblk -pndo pkname "$BOOT_PARTITION" 2>/dev/null)
if [ "$DISK" = "" ];then
 DISK=$(lsblk -pndo pkname "$ROOT_PARTITION" 2>/dev/null)
fi
if [ "$DISK" = "" ];then
 echo -e "\nUnable to determine parent disk, not executing\n"
 exit 1
fi
FILE=/tmp/PARTITIONING
START_LAST=$(parted "$DISK" unit s print free|grep -v Free|grep primary|tail -1|sed -e "s/\s \+/ /g"|awk '{print $4}'|sed -e "s/s$//")
N_PART=$(parted "$DISK" unit s print free|grep -v Free|grep primary|tail -1|sed -e "s/\s \+/ /g"|awk '{print $1}')
START=$(parted "$DISK" unit s print free|grep Free|tail -1|sed -e "s/\s \+/ /g"|awk '{print $1}'|sed -e "s/s$//")
END=$(parted "$DISK" unit s print free|grep Free|tail -1|sed -e "s/\s \+/ /g"|awk '{print $2}'|sed -e "s/s$//")
DIFF=$(($END-$START))
END_LAST=$(($START_LAST+$DIFF))

#############################################
#           Check Resize Needed             #
#############################################
if [ $DIFF -le 0 ];then
 echo -e "\nNo resize is needed\n"
 exit 0
fi

#############################################
#                   Resize                  #
#############################################
sfdisk -d "$DISK" > $FILE
echo "Changing $START_LAST to $END_LAST for $ROOT_PARTITION"
perl -p -i -e "s/^$ROOT_PARTITION_PATTERN : (.*) size=(.*) $START_LAST,/$ROOT_PARTITION_PATTERN : \1 size=       $END_LAST,/" $FILE
# Only grow the kernel's partition and the filesystem once the new size is
# in the partition table on the card: otherwise the filesystem would end
# beyond its partition at the next boot.
if ! grep -q "^$ROOT_PARTITION : .* size= *$END_LAST," "$FILE"; then
 echo -e "\nNo partition table entry for $ROOT_PARTITION to resize, not executing\n"
 exit 1
fi
cat "$FILE"|sfdisk --force --no-reread "$DISK" 1>/dev/null
# Read the table back rather than trusting sfdisk's exit status, and grow
# the kernel's partition to the size the card now records (sfdisk may have
# aligned it).
NEW_SIZE=$(sfdisk -d "$DISK" 2>/dev/null | grep "^$ROOT_PARTITION :" | sed -n 's/.*size= *\([0-9][0-9]*\),.*/\1/p' | head -1)
if [ -z "$NEW_SIZE" ] || [ "$NEW_SIZE" -le "$START_LAST" ] || [ "$NEW_SIZE" -gt "$END_LAST" ]; then
 echo -e "\nThe partition table does not hold the new size, not resizing\n"
 exit 1
fi
resizepart "$DISK" "$N_PART" "$NEW_SIZE"
resize2fs "$ROOT_PARTITION"

#############################################
#                    Sync                   #
#############################################
sync
