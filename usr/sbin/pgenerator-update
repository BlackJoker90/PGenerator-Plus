#!/bin/bash
#
# pgenerator-update — PGenerator+ OTA update via GitHub Releases
#
# Usage:
#   pgenerator-update check          — check for new version, print JSON
#   pgenerator-update apply          — download and apply latest release
#   pgenerator-update version        — print current version
#
# Update stream: GitHub Releases of the repository resolved below
# (resolve_update_repo), first match wins:
#   1. env GITHUB_REPO
#   2. update_repo=owner/repo in /etc/PGenerator/PGenerator.conf
#      (path overridable via PGENERATOR_CONF_FILE)
#   3. first non-comment line of /usr/share/PGenerator/update-channel
#      (path overridable via UPDATE_CHANNEL_FILE)
#   4. BigShoots/PGenerator-Plus
# Values that are not a plain owner/repo are ignored with a log entry.
#
# Each release may carry one OTA tarball per device target; the one matching
# this device is selected (detect_update_target, override PGEN_UPDATE_TARGET):
#   pi4-biasi          -> pgenerator-plus-<version>.tar.gz
#   pi5-bookworm-armhf -> pgenerator-plus-<version>-pi5-bookworm-armhf.tar.gz
#
# Release assets are tar.gz archives containing files in FHS layout:
#   usr/share/PGenerator/*.pm
#   usr/sbin/pgenerator-*
#   usr/bin/*
#   etc/PGenerator/*
#   etc/udev/rules.d/*
#
# The archive is extracted over / so paths must match the installed layout.
#

set -euo pipefail

DEFAULT_GITHUB_REPO="BigShoots/PGenerator-Plus"
PGENERATOR_CONF_FILE="${PGENERATOR_CONF_FILE:-/etc/PGenerator/PGenerator.conf}"
UPDATE_CHANNEL_FILE="${UPDATE_CHANNEL_FILE:-/usr/share/PGenerator/update-channel}"
DEVICE_MODEL_FILE="${DEVICE_MODEL_FILE:-/proc/device-tree/model}"
DEVICE_COMPATIBLE_FILE="${DEVICE_COMPATIBLE_FILE:-/proc/device-tree/compatible}"
# Set by resolve_update_repo / detect_update_target below.
UPDATE_REPO=""
UPDATE_REPO_SOURCE=""
UPDATE_TARGET=""
GITHUB_API=""
VERSION_FILE="${VERSION_FILE:-/usr/share/PGenerator/version.pm}"
UPDATE_MIGRATIONS_DIR="${UPDATE_MIGRATIONS_DIR:-/usr/share/PGenerator/update-migrations.d}"
EXEC_MANIFEST_FILE="${EXEC_MANIFEST_FILE:-/usr/share/PGenerator/release-exec-manifest.txt}"
UPDATE_DIR="${UPDATE_DIR:-/var/lib/PGenerator/updates}"
UPDATE_LOG="${UPDATE_LOG:-/var/log/PGenerator/update.log}"
CURL_OPTS="-s -L --connect-timeout 10 --max-time 60"
# The tarball is ~70 MB: a fixed 60 s ceiling failed every download below
# ~1.1 MB/s. Abort only when the transfer stalls (under 20 KB/s for 60 s).
CURL_DOWNLOAD_OPTS="-s -L --connect-timeout 10 --max-time 1800 --speed-limit 20480 --speed-time 60 --retry 2"
# While this file is fresh the WebUI watchdog does not restart PGenerator
# (it stops the daemon on purpose while extracting).
WATCHDOG_PAUSE_FILE="${WATCHDOG_PAUSE_FILE:-/tmp/pgenerator-watchdog.pause}"
# "<epoch>\n<phase>\n<message>" for the WebUI (/api/update/status), which
# keeps polling it across the daemon restart.
UPDATE_STATE_FILE="${UPDATE_STATE_FILE:-/tmp/pgenerator-update.state}"
LAST_ERROR=""
UPDATE_PHASE=""
GITHUB_ACCEPT="Accept: application/vnd.github.v3+json"
GITHUB_UA="User-Agent: PGenerator-Plus-Updater"
# Without a token GitHub allows 60 API requests per hour per public IP, shared
# by every device behind it, and every open WebUI tab checks for updates.
# Answers are cached: within GITHUB_CACHE_TTL seconds the cached answer is
# used without asking GitHub, and while GitHub refuses (rate limit, outage)
# the last good answer is used.
GITHUB_CACHE_DIR="${GITHUB_CACHE_DIR:-/var/lib/PGenerator/github-cache}"
GITHUB_CACHE_TTL="${GITHUB_CACHE_TTL:-300}"

# ── Read current version from version.pm ──
get_current_version() {
 grep '^\$version=' "$VERSION_FILE" 2>/dev/null | sed 's/.*="\([^"]*\)".*/\1/'
}

# ── Log with timestamp ──
# Optional third argument: progress of the phase in percent (0-100), written as
# a fourth line; empty when unknown. Readers that expect three lines ignore it.
set_update_state() {
 UPDATE_PHASE="$1"
 printf '%s\n%s\n%s\n%s\n' "$(date +%s)" "$1" "${2:-}" "${3:-}" > "$UPDATE_STATE_FILE.tmp" 2>/dev/null \
  && chmod 644 "$UPDATE_STATE_FILE.tmp" 2>/dev/null \
  && mv -f "$UPDATE_STATE_FILE.tmp" "$UPDATE_STATE_FILE" 2>/dev/null || true
}

log_msg() {
 local ts
 case "$*" in ERROR:*) LAST_ERROR="${*#ERROR: }";; esac
 ts=$(date '+%Y-%m-%d %H:%M:%S')
 mkdir -p "$(dirname "$UPDATE_LOG")" 2>/dev/null || true
 echo "[$ts] $*" >> "$UPDATE_LOG" 2>/dev/null || true
 echo "$*"
}

# ── Log to the update log only (keeps `check` stdout pure JSON) ──
log_file_only() {
 local ts
 ts=$(date '+%Y-%m-%d %H:%M:%S')
 mkdir -p "$(dirname "$UPDATE_LOG")" 2>/dev/null || true
 echo "[$ts] $*" >> "$UPDATE_LOG" 2>/dev/null || true
}

# ── Update source repository ──
# A repo is accepted only as a plain owner/repo; anything else (URLs, extra
# path segments, dot-only components) would let a config value steer the API
# request somewhere other than a releases endpoint.
valid_repo() {
 local repo="$1" owner name
 local re='^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'
 [[ "$repo" =~ $re ]] || return 1
 owner="${repo%%/*}"
 name="${repo#*/}"
 case "$owner" in *[!.]*) ;; *) return 1 ;; esac
 case "$name" in *[!.]*) ;; *) return 1 ;; esac
 return 0
}

# Trim surrounding whitespace, a trailing CR and one pair of quotes.
trim_value() {
 local v="$1"
 v="${v%$'\r'}"
 v="${v#"${v%%[![:space:]]*}"}"
 v="${v%"${v##*[![:space:]]}"}"
 case "$v" in
  \"*\") v="${v#\"}"; v="${v%\"}" ;;
  \'*\') v="${v#\'}"; v="${v%\'}" ;;
 esac
 printf '%s' "$v"
}

conf_update_repo() {
 [ -r "$PGENERATOR_CONF_FILE" ] || return 0
 local line
 line="$(grep -E '^[[:space:]]*update_repo[[:space:]]*=' "$PGENERATOR_CONF_FILE" 2>/dev/null | tail -n 1 || true)"
 [ -n "$line" ] || return 0
 trim_value "${line#*=}"
}

channel_update_repo() {
 [ -r "$UPDATE_CHANNEL_FILE" ] || return 0
 local line
 while IFS= read -r line || [ -n "$line" ]; do
  line="$(trim_value "$line")"
  case "$line" in ''|'#'*) continue ;; esac
  printf '%s' "$line"
  return 0
 done < "$UPDATE_CHANNEL_FILE"
}

# Sets UPDATE_REPO, UPDATE_REPO_SOURCE and GITHUB_API.
resolve_update_repo() {
 local candidate source
 local env_repo="${GITHUB_REPO:-}"
 UPDATE_REPO=""
 for source in env conf channel; do
  case "$source" in
   env) candidate="$(trim_value "$env_repo")" ;;
   conf) candidate="$(conf_update_repo)" ;;
   channel) candidate="$(channel_update_repo)" ;;
  esac
  [ -n "$candidate" ] || continue
  if valid_repo "$candidate"; then
   UPDATE_REPO="$candidate"
   case "$source" in
    env) UPDATE_REPO_SOURCE="env GITHUB_REPO" ;;
    conf) UPDATE_REPO_SOURCE="$PGENERATOR_CONF_FILE (update_repo)" ;;
    channel) UPDATE_REPO_SOURCE="$UPDATE_CHANNEL_FILE" ;;
   esac
   break
  fi
  log_file_only "WARNING: ignoring invalid update repo '$candidate' from $source (expected owner/repo)"
 done
 if [ -z "$UPDATE_REPO" ]; then
  UPDATE_REPO="$DEFAULT_GITHUB_REPO"
  UPDATE_REPO_SOURCE="built-in default"
 fi
 GITHUB_API="https://api.github.com/repos/${UPDATE_REPO}/releases/latest"
}

# ── Device target (selects the matching OTA asset) ──
# Sets UPDATE_TARGET to pi5-bookworm-armhf on a Raspberry Pi 5 / CM5
# (BCM2712), otherwise pi4-biasi. PGEN_UPDATE_TARGET overrides detection.
detect_update_target() {
 local model=""
 case "${PGEN_UPDATE_TARGET:-}" in
  pi4-biasi|pi5-bookworm-armhf)
   UPDATE_TARGET="$PGEN_UPDATE_TARGET"
   return 0
   ;;
  "") ;;
  *) log_file_only "WARNING: ignoring unknown PGEN_UPDATE_TARGET '$PGEN_UPDATE_TARGET'" ;;
 esac
 if [ -r "$DEVICE_MODEL_FILE" ]; then
  model="$(tr -d '\000' < "$DEVICE_MODEL_FILE" 2>/dev/null || true)"
 fi
 if [ -r "$DEVICE_COMPATIBLE_FILE" ]; then
  model="$model $(tr '\000' ' ' < "$DEVICE_COMPATIBLE_FILE" 2>/dev/null || true)"
 fi
 case "$model" in
  *"Raspberry Pi 5"*|*"Compute Module 5"*|*BCM2712*|*bcm2712*) UPDATE_TARGET="pi5-bookworm-armhf" ;;
  *) UPDATE_TARGET="pi4-biasi" ;;
 esac
}

mount_options_for_path() {
 local path="${1:-/}"
 if command -v findmnt >/dev/null 2>&1; then
  findmnt -no OPTIONS -T "$path" 2>/dev/null || true
  return 0
 fi
 awk -v target="$path" '$2 == target {print $4; exit}' /proc/mounts 2>/dev/null || true
}

path_is_read_only() {
 local opts
 opts="$(mount_options_for_path "${1:-/}")"
 printf '%s' "$opts" | tr ',' '\n' | grep -qx 'ro'
}

require_writable_path() {
 local path="$1"
 local label="$2"
 local probe

 mkdir -p "$path" 2>/dev/null || true

 if path_is_read_only "$path"; then
  log_msg "ERROR: ${label} is mounted read-only: $path"
  echo "ERROR: ${label} is mounted read-only"
  return 1
 fi

 probe="$path/.pgenerator-update-write-test.$$"
 if ! : > "$probe" 2>/dev/null; then
  log_msg "ERROR: Cannot write to ${label}: $path"
  echo "ERROR: Cannot write to ${label}"
  return 1
 fi
 rm -f "$probe" 2>/dev/null || true
}

# ── Apply safety net ──
# Files the update overwrites are saved first; if anything fails after
# PGenerator was stopped, they are restored and PGenerator is started again
# instead of leaving a half-updated, stopped device.
ROLLBACK_TARBALL=""
APPLY_STOPPED=0
APPLY_DONE=0

apply_cleanup() {
 local rc=$?
 if [ "$rc" != "0" ]; then
  local why="${LAST_ERROR:-Update failed while ${UPDATE_PHASE:-starting} (exit $rc)}"
  if [ "$APPLY_STOPPED" = "1" ] && [ "$APPLY_DONE" != "1" ]; then
   set_update_state failed "$why. The previous version was restored."
  else
   set_update_state failed "$why"
  fi
 fi
 if [ "$APPLY_STOPPED" = "1" ] && [ "$APPLY_DONE" != "1" ]; then
  log_msg "ERROR: Update failed after PGenerator was stopped (exit $rc)"
  if [ -n "$ROLLBACK_TARBALL" ] && [ -s "$ROLLBACK_TARBALL" ]; then
   log_msg "Restoring the previous files from $ROLLBACK_TARBALL"
   if (cd / && tar xzf "$ROLLBACK_TARBALL") >>"$UPDATE_LOG" 2>&1; then
    log_msg "Previous files restored"
   else
    log_msg "ERROR: Restoring the previous files failed"
    set_update_state failed "Update failed while installing, and restoring the previous files failed too. Run the update again or re-flash the image."
   fi
  fi
  log_msg "Starting PGenerator again"
  /etc/init.d/PGenerator start >/dev/null 2>&1 || log_msg "ERROR: PGenerator start failed"
 fi
 [ -n "$ROLLBACK_TARBALL" ] && rm -f "$ROLLBACK_TARBALL"
 [ -n "${tarball:-}" ] && rm -f "$tarball"
 rm -f "$WATCHDOG_PAUSE_FILE"
 return $rc
}

# The published "<tarball>.sha256" ("<hash>  <name>"). Releases from before
# it was published have none: that is logged and the update goes on.
verify_tarball_checksum() {
 local tarball="$1" url="$2" sum_file expected actual
 sum_file="$tarball.sha256"
 if ! curl -f $CURL_OPTS -H "$GITHUB_UA" -o "$sum_file" "$url.sha256" 2>/dev/null || [ ! -s "$sum_file" ]; then
  rm -f "$sum_file"
  log_msg "No published SHA-256 for this release; relying on the archive check"
  return 0
 fi
 expected=$(awk 'NR==1{print $1}' "$sum_file" | tr 'A-F' 'a-f')
 rm -f "$sum_file"
 actual=$(sha256sum "$tarball" | awk '{print $1}')
 if [ "${#expected}" != "64" ] || [ "$expected" != "$actual" ]; then
  log_msg "ERROR: SHA-256 mismatch (expected ${expected:-none}, got $actual)"
  return 1
 fi
 log_msg "SHA-256 verified: $actual"
}

# Free space for the extracted files plus the rollback copy (both about the
# uncompressed size at worst) and a margin.
check_free_space() {
 local tarball="$1" need_kb avail_kb unpacked
 unpacked=$(gzip -l "$tarball" 2>/dev/null | awk 'NR==2{print $2}')
 case "$unpacked" in (''|*[!0-9]*) unpacked=0;; esac
 need_kb=$(( unpacked / 1024 * 2 + 51200 ))
 avail_kb=$(df -Pk / | awk 'NR==2{print $4}')
 case "$avail_kb" in (''|*[!0-9]*) return 0;; esac
 if [ "$avail_kb" -lt "$need_kb" ]; then
  log_msg "ERROR: Not enough free space: ${avail_kb} KB free, ${need_kb} KB needed"
  return 1
 fi
}

# Save the files the update will overwrite (only those that exist now).
create_rollback() {
 local tarball="$1" list
 list="$UPDATE_DIR/rollback-files.$$"
 tar tzf "$tarball" | sed 's#^\./##' | while IFS= read -r f; do
  [ -n "$f" ] || continue
  if [ -f "/$f" ] || [ -L "/$f" ]; then printf '%s\n' "$f"; fi
 done > "$list"
 ROLLBACK_TARBALL="$UPDATE_DIR/rollback-$(get_current_version).tar.gz"
 if ! (cd / && tar czf "$ROLLBACK_TARBALL" -T "$list") 2>>"$UPDATE_LOG"; then
  rm -f "$list" "$ROLLBACK_TARBALL"
  ROLLBACK_TARBALL=""
  log_msg "ERROR: Could not save the current files for rollback"
  return 1
 fi
 log_msg "Saved $(wc -l < "$list") current files for rollback"
 rm -f "$list"
}

wait_for_local_api() {
 local attempts="${1:-30}"
 local n=0
 local response=""
 while [ "$n" -lt "$attempts" ]; do
  response="$(curl -s --connect-timeout 2 --max-time 3 http://127.0.0.1/api/ping 2>/dev/null || true)"
  if printf '%s' "$response" | grep -q '"ok"[[:space:]]*:[[:space:]]*1'; then
   return 0
  fi
  n=$((n + 1))
  sleep 1
 done
 return 1
}

# ── Pi images may boot without a valid RTC-backed clock ──
clock_seems_invalid() {
 local year
 year=$(date -u +%Y 2>/dev/null || echo 0)
 [ "$year" -lt 2024 ]
}

sync_clock() {
 local server
 for server in pool.ntp.org time.google.com; do
  if command -v ntpdate >/dev/null 2>&1 && timeout 3 ntpdate -ub "$server" >/dev/null 2>&1; then
   return 0
  fi
  if command -v sntp >/dev/null 2>&1 && timeout 3 sntp -sS "$server" >/dev/null 2>&1; then
   return 0
  fi
  if command -v ntpd >/dev/null 2>&1 && timeout 3 ntpd -qn -p "$server" >/dev/null 2>&1; then
   return 0
  fi
 done
 return 1
}

ensure_valid_clock() {
 if ! clock_seems_invalid; then
  return 0
 fi
 log_msg "System clock appears invalid; attempting NTP sync..."
 if sync_clock; then
  log_msg "System clock synced: $(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"
  return 0
 fi
 log_msg "Clock sync failed; GitHub TLS validation may not work"
 return 1
}

# ── GitHub API GET with cache ──
# Prints the response body. Returns 0 for a 2xx answer (fresh or cached),
# 1 otherwise; the body is then GitHub's error JSON or, when GitHub is out of
# requests, one that names the time until the limit resets.
github_get() {
 local url="$1" base hdr body code now age etag reset mins
 local -a cond=()
 base="$GITHUB_CACHE_DIR/$(printf '%s' "$url" | md5sum | cut -c1-32)"
 mkdir -p "$GITHUB_CACHE_DIR" 2>/dev/null || true
 now=$(date +%s)
 if [ -s "$base.json" ]; then
  age=$(( now - $(stat -c %Y "$base.json" 2>/dev/null || echo 0) ))
  if [ "$age" -ge 0 ] && [ "$age" -lt "$GITHUB_CACHE_TTL" ]; then
   cat "$base.json"
   return 0
  fi
  if [ -s "$base.etag" ]; then
   etag=$(cat "$base.etag")
   cond=(-H "If-None-Match: $etag")
  fi
 fi
 ensure_valid_clock >/dev/null 2>&1 || true
 hdr=$(mktemp) body=$(mktemp)
 code=$(curl $CURL_OPTS -H "$GITHUB_ACCEPT" -H "$GITHUB_UA" ${cond[@]+"${cond[@]}"} -D "$hdr" -o "$body" -w '%{http_code}' "$url" 2>/dev/null) || true
 case "$code" in
  2??)
   if [ -s "$body" ]; then
    etag=$(tr -d '\r' <"$hdr" | sed -n 's/^[Ee][Tt][Aa][Gg]: *//p' | tail -1)
    cp "$body" "$base.json.new" && mv -f "$base.json.new" "$base.json"
    if [ -n "$etag" ]; then printf '%s' "$etag" >"$base.etag"; else rm -f "$base.etag"; fi
   fi
   cat "$body"
   rm -f "$hdr" "$body"
   return 0
   ;;
  304)
   touch "$base.json"
   cat "$base.json"
   rm -f "$hdr" "$body"
   return 0
   ;;
 esac
 if [ -s "$base.json" ] && [ "$code" != 404 ]; then
  log_file_only "GitHub answered HTTP ${code:-000} for $url; using the cached answer"
  # Note the refusal for the caller ($$ is the main shell's PID even in the
  # $(...) subshell this runs in): when the answer was last confirmed and,
  # for a rate limit, when GitHub takes requests again.
  reset=""
  if { [ "$code" = 403 ] || [ "$code" = 429 ]; } && tr -d '\r' <"$hdr" | grep -qi '^x-ratelimit-remaining: *0$'; then
   reset=$(tr -d '\r' <"$hdr" | sed -n 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]eset: *//p' | tail -1)
  fi
  printf '%s %s %s\n' "$(stat -c %Y "$base.json" 2>/dev/null || echo 0)" "${reset:-0}" "${code:-000}" >"$GITHUB_CACHE_DIR/stale.$$" 2>/dev/null || true
  cat "$base.json"
  rm -f "$hdr" "$body"
  return 0
 fi
 if { [ "$code" = 403 ] || [ "$code" = 429 ]; } && tr -d '\r' <"$hdr" | grep -qi '^x-ratelimit-remaining: *0$'; then
  reset=$(tr -d '\r' <"$hdr" | sed -n 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]eset: *//p' | tail -1)
  mins=$(( ( ${reset:-$now} - now + 59 ) / 60 ))
  [ "$mins" -ge 1 ] || mins=1
  printf '{"message":%s}' "$(json_escape "GitHub allows 60 requests per hour from your network without a login, and they are used up. Try again in $mins min.")"
 else
  cat "$body"
 fi
 rm -f "$hdr" "$body"
 return 1
}

# Message of a GitHub error JSON, or a generic one.
github_error_message() {
 printf '%s' "$1" | perl -MJSON::PP -e 'local $/; my $j=eval { JSON::PP::decode_json(<STDIN>) }; my $m=(ref($j) eq "HASH" ? $j->{message} : "") // ""; print($m ne "" ? $m : "Cannot reach GitHub");'
}

# ── Fetch latest release info from GitHub ──
get_latest_release() {
 github_get "$GITHUB_API" || true
}

# One release by version, for installing an older (or the same) release.
get_release_by_version() {
 local version="$1" json
 json=$(github_get "https://api.github.com/repos/${UPDATE_REPO}/releases/tags/v${version}") || json=""
 [ -n "$json" ] || json=$(github_get "https://api.github.com/repos/${UPDATE_REPO}/releases/tags/${version}") || json=""
 printf '%s' "$json"
}

# The newest installable releases as JSON for the WebUI: same OTA family as
# the running version, an OTA tarball for this target, no drafts or betas.
list_releases() {
 local current="$1" limit="${2:-10}" json
 if ! json=$(github_get "https://api.github.com/repos/${UPDATE_REPO}/releases?per_page=50"); then
  printf '{"status":"error","message":%s}\n' "$(json_escape "$(github_error_message "$json")")"
  return 1
 fi
 printf '%s' "$json" | perl -MJSON::PP -e '
  my ($current,$family,$target,$limit)=@ARGV;
  local $/;
  my $rels=eval { JSON::PP::decode_json(<STDIN>) };
  if(ref($rels) ne "ARRAY") { print "{\"status\":\"error\",\"message\":\"Cannot parse the release list\"}"; exit 1; }
  my @out;
  for my $rel (@$rels) {
   next if(ref($rel) ne "HASH" || $rel->{draft} || $rel->{prerelease});
   my $ver=($rel->{tag_name}//"")=~s/^v//r;
   next if($ver!~/^\d+(?:\.\d+)+$/);
   my @p=split(/\./,$ver);
   next if("$p[0].$p[1]" ne $family);
   my $has=0;
   for my $a (@{$rel->{assets}||[]}) {
    my $n=$a->{name}//"";
    next if($n!~/\.tar\.gz$/i || $n!~/^pgenerator[-_]?plus[-_]v?[0-9]/i);
    if($target eq "pi5-bookworm-armhf") { $has=1 if($n=~/pi5[-_]bookworm[-_]armhf\.tar\.gz$/i); }
    else { $has=1 if($n!~/pi5/i); }
   }
   next if(!$has);
   my $notes=($rel->{body}//"")=~s/\r//gr;
   $notes=substr($notes,0,400);
   push @out,{version=>$ver,published=>($rel->{published_at}//""),notes=>$notes,current=>($ver eq $current ? JSON::PP::true : JSON::PP::false)};
  }
  my $vk=sub { join(".",map { sprintf("%06d",$_) } split(/\./,$_[0])) };
  @out=sort { $vk->($b->{version}) cmp $vk->($a->{version}) } @out;
  splice(@out,$limit) if(@out>$limit);
  print JSON::PP->new->canonical->encode({status=>"ok",current=>$current,family=>$family,releases=>\@out});
 ' "$current" "$(major_version "$current")" "${UPDATE_TARGET:-pi4-biasi}" "$limit"
}

# ── JSON-escape a scalar for Web UI / API responses ──
json_escape() {
 printf '%s' "$1" | perl -MJSON::PP -e 'local $/; my $s=<>; print JSON::PP->new->allow_nonref->encode($s);'
}

# ── Extract a field from the GitHub release JSON ──
release_field() {
 local key="$1"
 printf '%s' "$release_json" | perl -MJSON::PP -e '
  use JSON::PP qw(decode_json);
  my $key = shift;
  my $target = shift // "pi4-biasi";
  local $/;
  my $json = <STDIN>;
  my $rel = eval { decode_json($json) };
  exit 1 if(!$rel || ref($rel) ne "HASH");
  my $value = "";
  if($key eq "asset_url" || $key eq "asset_size") {
   # Pick ONLY the tarball built for this device target; a release may carry
   # both. No match means no asset (never fall back to another target).
   #   pi4-biasi:          pgenerator-plus-<ver>.tar.gz (optional -pi4-biasi)
   #   pi5-bookworm-armhf: pgenerator-plus-<ver>-pi5-bookworm-armhf.tar.gz
   if(ref($rel->{assets}) eq "ARRAY") {
    for my $asset (@{$rel->{assets}}) {
     next if(ref($asset) ne "HASH");
     my $url = $asset->{browser_download_url} // "";
     my $name = $asset->{name} // "";
     next if($url !~ /\.tar\.gz$/i);
     next if($name !~ /^pgenerator[-_]?plus[-_]v?[0-9]/i);
     my $match = 0;
     if($target eq "pi5-bookworm-armhf") {
      $match = 1 if($name =~ /^pgenerator[-_]?plus[-_]v?[0-9][0-9A-Za-z._]*[-_]pi5[-_]bookworm[-_]armhf\.tar\.gz$/i);
     } else {
      $match = 1 if($name =~ /^pgenerator[-_]?plus[-_]v?[0-9][0-9A-Za-z._]*(?:[-_]pi4[-_]biasi)?\.tar\.gz$/i
       && $name !~ /pi5/i);
     }
     if($match) {
      if($key eq "asset_size") {
       my $size = $asset->{size} // "";
       $value = ($size =~ /^[0-9]+$/ && $size > 0) ? $size : "";
      } else {
       $value = $url;
      }
      last;
     }
    }
   }
  } elsif($key eq "body") {
   $value = $rel->{body} // "";
   $value =~ s/\r\n/\n/g;
   $value =~ s/\r/\n/g;
   $value = substr($value,0,8000);
  } else {
   $value = $rel->{$key} // "";
  }
  print $value;
 ' "$key" "${UPDATE_TARGET:-pi4-biasi}"
}

# ── Compare semver: returns 0 if $1 > $2 ──
normalize_version() {
 local version="${1:-0}"
 version="${version#v}"
 [ -n "$version" ] || version="0"
 printf '%s' "$version"
}

# Return the MAJOR.MINOR prefix (first two dotted segments) of a version
# string. OTA updates are gated on this: a device on 2.7.x can only OTA to
# another 2.7.x release; 2.8.x stays within 2.8.x. Crossing a MAJOR.MINOR
# boundary requires re-flashing the image (e.g. a new kernel driver).
major_version() {
 local v major minor
 v=$(normalize_version "${1:-0}")
 major=$(printf '%s' "$v" | cut -d. -f1)
 minor=$(printf '%s' "$v" | cut -d. -f2)
 [ -n "$major" ] || major="0"
 [ -n "$minor" ] || minor="0"
 printf '%s.%s' "$major" "$minor"
}

# True if current and target share the same MAJOR.MINOR OTA family.
same_ota_family() {
 [ "$(major_version "${1:-0}")" = "$(major_version "${2:-0}")" ]
}

is_prerelease_version() {
 local version
 version=$(normalize_version "$1")
 case "$version" in
  *[!0-9.]* ) return 0 ;;
 esac
 return 1
}

version_gt() {
 local a b
 a=$(normalize_version "$1")
 b=$(normalize_version "$2")
 [ "$a" != "$b" ] && [ "$(printf '%s\n%s' "$a" "$b" | sort -V | tail -1)" = "$a" ]
}

version_le() {
 local a b
 a=$(normalize_version "$1")
 b=$(normalize_version "$2")
 [ "$a" = "$b" ] || [ "$(printf '%s\n%s' "$a" "$b" | sort -V | tail -1)" = "$b" ]
}

migration_script_version() {
 local base
 base="$(basename "$1")"
 printf '%s' "$base" | sed -E 's/^v?([0-9]+(\.[0-9]+)*).*/\1/'
}

# OTA tarballs ship factory defaults as PGenerator.conf.dist and never
# overwrite the device's live /etc/PGenerator/PGenerator.conf (it holds
# operator state: signal mode, HDR metadata, DV transport, ...). After
# extraction, append any NEW default keys the release introduced so code
# that expects them always finds a value, while existing values are kept.
merge_conf_defaults() {
 local dist="/etc/PGenerator/PGenerator.conf.dist"
 local conf="/etc/PGenerator/PGenerator.conf"
 local line key added
 [ -f "$dist" ] || return 0
 if [ ! -f "$conf" ]; then
  cp -a "$dist" "$conf"
  log_msg "conf: installed factory defaults (no existing PGenerator.conf)"
  return 0
 fi
 added=0
 while IFS= read -r line; do
  case "$line" in ''|'#'*) continue ;; esac
  key="${line%%=*}"
  [ -n "$key" ] || continue
  case "$key" in *[!A-Za-z0-9_]* ) continue ;; esac
  if ! grep -q "^${key}=" "$conf"; then
   printf '%s\n' "$line" >> "$conf"
   added=$((added + 1))
   log_msg "conf: added new default key ${key}"
  fi
 done < "$dist"
 [ "$added" -gt 0 ] && sync || true
}

# ── Restore executable bits after extraction ──
# tar restores whatever modes the archive carries, so a payload built from a
# checkout with core.filemode=false arrives with its scripts non-executable —
# 2.11.6 and 2.11.7 landed /etc/init.d/rcPGenerator as 0664, which stops the
# daemon from starting at boot and makes this script's own restart fail.
# Every release from 2.11.8 records the program files it ships in
# release-exec-manifest.txt; reapply them before anything is run.
restore_exec_bits() {
 local manifest="$1"
 local restored=0
 local path rel

 [[ -f "$manifest" ]] || return 0

 while IFS= read -r rel; do
  [[ -n "$rel" ]] || continue
  case "$rel" in
   \#*|/*|*..*) continue ;;
  esac
  path="/$rel"
  [[ -f "$path" ]] || continue
  [[ -x "$path" ]] && continue
  chmod 0755 "$path" 2>/dev/null || true
  restored=$((restored + 1))
 done < "$manifest"

 if [[ "$restored" -gt 0 ]]; then
  log_msg "Restored executable bits on $restored extracted program files"
 fi
}

run_update_migrations() {
 local from_version target_version migration_count path script_version base
 from_version=$(normalize_version "${1:-0}")
 target_version=$(normalize_version "${2:-0}")
 migration_count=0

 [ -d "$UPDATE_MIGRATIONS_DIR" ] || return 0

 while IFS= read -r path; do
  [ -n "$path" ] || continue
  base="$(basename "$path")"
  script_version=$(migration_script_version "$base")
  if [ -z "$script_version" ] || [ "$script_version" = "$base" ]; then
   log_msg "Skipping OTA migration with unparseable version: $base"
   continue
  fi
  if version_gt "$script_version" "$from_version" && version_le "$script_version" "$target_version"; then
   migration_count=$((migration_count + 1))
   log_msg "Running OTA migration $base"
   chmod +x "$path" 2>/dev/null || true
   if ! PG_UPDATE_FROM="$from_version" PG_UPDATE_TO="$target_version" PG_MIGRATION_VERSION="$script_version" "$path" >> "$UPDATE_LOG" 2>&1; then
    log_msg "ERROR: OTA migration failed: $base"
    echo "ERROR: OTA migration failed: $base"
    return 1
   fi
  fi
 done < <(find "$UPDATE_MIGRATIONS_DIR" -maxdepth 1 -type f -name '*.sh' | sort -V)

 if [ "$migration_count" -eq 0 ]; then
  log_msg "No OTA migrations needed for $from_version -> $target_version"
 fi
}

cmd="${1:-help}"

case "$cmd" in

 version)
  echo "$(get_current_version)"
  ;;

 check)
  # "check --fresh" (Check for Updates in the WebUI) skips the cache window
  # and asks GitHub now (conditional, ETag); a refusal still falls back to
  # the cached answer.
  [ "${2:-}" = "--fresh" ] && GITHUB_CACHE_TTL=0
  resolve_update_repo
  detect_update_target
  log_file_only "Update check: repo $UPDATE_REPO (from $UPDATE_REPO_SOURCE), target $UPDATE_TARGET"
  repo_json="$(json_escape "$UPDATE_REPO")"
  target_json="$(json_escape "$UPDATE_TARGET")"
  current=$(get_current_version)
  rm -f "$GITHUB_CACHE_DIR/stale.$$"
  find "$GITHUB_CACHE_DIR" -maxdepth 1 -name 'stale.*' -mmin +10 -delete 2>/dev/null || true
  release_json=$(get_latest_release)
  if [ -z "$release_json" ]; then
   printf '{"status":"error","repo":%s,"target":%s,"message":%s}\n' "$repo_json" "$target_json" "$(json_escape "Cannot reach GitHub")"
   exit 1
  fi

  latest=$(release_field tag_name 2>/dev/null | sed 's/^v//')
  message=$(release_field message 2>/dev/null || true)
  published=$(release_field published_at 2>/dev/null || true)
  changelog=$(release_field body 2>/dev/null || true)
  asset_url=$(release_field asset_url 2>/dev/null || true)

    if is_prerelease_version "$current"; then
     printf '{"status":"ok","repo":%s,"target":%s,"current":%s,"latest":%s,"update_available":false,"published":%s,"changelog":%s,"asset_url":""}\n' \
      "$repo_json" "$target_json" \
      "$(json_escape "$current")" \
      "$(json_escape "$current")" \
      "$(json_escape "")" \
      "$(json_escape "OTA updates are disabled on beta builds. Flash a matching stable or newer beta image instead.")"
     exit 0
    fi

  if [ -z "$latest" ] && [ "$message" = "Not Found" ]; then
   printf '{"status":"ok","repo":%s,"target":%s,"current":%s,"latest":%s,"update_available":false,"published":"","changelog":%s,"asset_url":""}\n' \
    "$repo_json" "$target_json" \
    "$(json_escape "$current")" \
    "$(json_escape "$current")" \
    "$(json_escape "No releases published yet.")"
   exit 0
  fi

  if [ -z "$latest" ]; then
   [ -z "$message" ] && message="Cannot parse release info"
   printf '{"status":"error","repo":%s,"target":%s,"message":%s}\n' "$repo_json" "$target_json" "$(json_escape "$message")"
   exit 1
  fi

  if version_gt "$latest" "$current"; then
   update_available=true
  else
   update_available=false
  fi

  # OTA family gate: only offer OTA updates within the same MAJOR.MINOR
  # family (e.g. 2.7.x -> 2.7.x). Crossing to a new family (2.7.x -> 2.8.x)
  # requires re-flashing because the release may ship a new kernel driver
  # or other changes that cannot be expressed as a tar overlay.
  if ! same_ota_family "$current" "$latest"; then
   update_available=false
   changelog="A newer image release ($latest) is available, but it is outside the OTA family of your current version ($current). OTA updates only apply within the same major.minor series (e.g. 2.7.x -> 2.7.x). To move to $latest, download the full image and re-flash your SD card."
  fi

  # A newer release that carries no tarball for this device target is not an
  # OTA update for this device (never offer another target's package).
  if [ "$update_available" = true ] && [ -z "$asset_url" ]; then
   update_available=false
   changelog="Release $latest has no OTA package for this device ($UPDATE_TARGET) in $UPDATE_REPO."
  fi

  # GitHub refused and the answer came from the cache: tell the WebUI how old
  # it is, so "no update" is not taken as current.
  stale_fields=""
  if [ -s "$GITHUB_CACHE_DIR/stale.$$" ]; then
   read -r cached_at reset code <"$GITHUB_CACHE_DIR/stale.$$"
   now=$(date +%s)
   retry_minutes=0
   [ "${reset:-0}" -gt "$now" ] && retry_minutes=$(( (reset - now + 59) / 60 ))
   stale_reason="unreachable"
   [ "${reset:-0}" -gt 0 ] && stale_reason="rate_limit"
   stale_fields=$(printf ',"stale":true,"stale_reason":"%s","cached_at":%d,"retry_minutes":%d' "$stale_reason" "${cached_at:-0}" "$retry_minutes")
  fi
  rm -f "$GITHUB_CACHE_DIR/stale.$$"

  printf '{"status":"ok","repo":%s,"target":%s,"current":%s,"latest":%s,"update_available":%s,"published":%s,"changelog":%s,"asset_url":%s%s}\n' \
   "$repo_json" "$target_json" \
   "$(json_escape "$current")" \
   "$(json_escape "$latest")" \
   "$update_available" \
   "$(json_escape "$published")" \
   "$(json_escape "$changelog")" \
   "$(json_escape "$asset_url")" \
   "$stale_fields"
  ;;

 list)
  resolve_update_repo
  detect_update_target
  list_releases "$(get_current_version)" 10
  ;;

 apply)
  trap apply_cleanup EXIT
  # Optional: a specific release (older, or the same one to repair the
  # install). Without it, the latest release.
  requested=$(normalize_version "${2:-}")
  [ -n "${2:-}" ] || requested=""
  if [ -n "$requested" ] && ! printf '%s' "$requested" | grep -Eq '^[0-9]+(\.[0-9]+)+$'; then
   log_msg "ERROR: Invalid version: ${2:-}"
   exit 1
  fi
  set_update_state checking "Looking for ${requested:-the update}"
  # Install from GitHub's current answer; the cache only stands in while
  # GitHub refuses.
  GITHUB_CACHE_TTL=0
  resolve_update_repo
  detect_update_target
  current=$(get_current_version)
  log_msg "Update check started (current: $current${requested:+, requested: $requested})"
  log_msg "Update source: $UPDATE_REPO (from $UPDATE_REPO_SOURCE), device target: $UPDATE_TARGET"

  if [ -n "$requested" ]; then
   release_json=$(get_release_by_version "$requested")
  else
   release_json=$(get_latest_release)
  fi
  if [ -z "$release_json" ]; then
   if [ -n "$requested" ]; then
    log_msg "ERROR: Release $requested not found (or GitHub unreachable)"
    echo "ERROR: Release $requested not found (or GitHub unreachable)"
   else
    log_msg "ERROR: Cannot reach GitHub"
    echo "ERROR: Cannot reach GitHub"
   fi
   exit 1
  fi

  latest=$(release_field tag_name 2>/dev/null | sed 's/^v//')
  asset_url=$(release_field asset_url 2>/dev/null || true)
  message=$(release_field message 2>/dev/null || true)

    if is_prerelease_version "$current"; then
     log_msg "ERROR: OTA updates are disabled on beta builds ($current)"
     echo "ERROR: OTA updates are disabled on beta builds ($current)"
     exit 1
    fi

  if [ -z "$latest" ]; then
   [ -z "$message" ] && message="Cannot parse release info"
   log_msg "ERROR: $message"
   echo "ERROR: $message"
   exit 1
  fi

  if [ -n "$requested" ] && [ "$latest" != "$requested" ]; then
   log_msg "ERROR: Release $requested not found (got ${latest:-nothing})"
   exit 1
  fi

  if [ -z "$requested" ] && ! version_gt "$latest" "$current"; then
   log_msg "Already up to date ($current)"
   set_update_state done "Already up to date ($current)"
   echo "Already up to date ($current)"
   exit 0
  fi

  # OTA family gate: refuse to apply an update that crosses a MAJOR.MINOR
  # boundary. Such releases may ship a new kernel driver or other changes
  # that cannot be delivered as a tar overlay; the user must re-flash.
  if ! same_ota_family "$current" "$latest"; then
   log_msg "ERROR: $latest is outside the OTA family of $current -- re-flash the image"
   echo "ERROR: Release $latest is outside the OTA family of your current version $current."
   echo "OTA updates only apply within the same major.minor series (e.g. 2.7.x -> 2.7.x)."
   echo "To install $latest, download the full image and re-flash your SD card."
   exit 1
  fi

  if [ -z "$asset_url" ]; then
   log_msg "ERROR: No $UPDATE_TARGET OTA asset (.tar.gz) found in release $latest of $UPDATE_REPO"
   echo "ERROR: No .tar.gz asset for target $UPDATE_TARGET found in release"
   exit 1
  fi

    require_writable_path "$UPDATE_DIR" "update directory"
    require_writable_path "/usr/share/PGenerator" "PGenerator install tree"

  log_msg "Downloading $latest from $asset_url"
  mkdir -p "$UPDATE_DIR"
  tarball="$UPDATE_DIR/pgenerator-plus-${latest}.tar.gz"
  # The size GitHub lists for the asset turns the bytes on disk into a
  # percentage for the WebUI; without it the percentage stays empty.
  asset_size=$(release_field asset_size 2>/dev/null || true)
  case "$asset_size" in ''|*[!0-9]*) asset_size="";; esac
  rm -f "$tarball"
  set_update_state downloading "Downloading $latest" "${asset_size:+0}"
  curl -f $CURL_DOWNLOAD_OPTS -H "$GITHUB_UA" -o "$tarball" "$asset_url" 2>/dev/null &
  curl_pid=$!
  while kill -0 "$curl_pid" 2>/dev/null; do
   if [ -n "$asset_size" ] && [ -f "$tarball" ]; then
    got=$(wc -c 2>/dev/null <"$tarball" || echo 0)
    got=$(printf '%s' "$got" | tr -cd '0-9')
    pct=$(( ${got:-0} * 100 / asset_size ))
    if [ "$pct" -gt 100 ]; then pct=100; fi
    set_update_state downloading "Downloading $latest" "$pct"
   fi
   sleep 1
  done
  curl_rc=0
  wait "$curl_pid" || curl_rc=$?
  if [ "$curl_rc" != "0" ]; then
   log_msg "ERROR: Download failed"
   echo "ERROR: Download failed"
   exit 1
  fi
  if [ -n "$asset_size" ]; then set_update_state downloading "Downloading $latest" 100; fi

  if [ ! -s "$tarball" ]; then
   log_msg "ERROR: Download failed or empty file"
   echo "ERROR: Download failed"
   exit 1
  fi

  set_update_state verifying "Verifying the download"
  if ! verify_tarball_checksum "$tarball" "$asset_url"; then
   echo "ERROR: Update archive checksum mismatch"
   rm -f "$tarball"
   exit 1
  fi

  if ! tar tzf "$tarball" >/dev/null 2>&1; then
   log_msg "ERROR: Downloaded asset is not a valid tar.gz archive"
   echo "ERROR: Invalid update archive"
   rm -f "$tarball"
   exit 1
  fi

  if ! check_free_space "$tarball"; then
   echo "ERROR: Not enough free space for the update"
   rm -f "$tarball"
   exit 1
  fi

  set_update_state backup "Saving the current files"
  if ! create_rollback "$tarball"; then
   echo "ERROR: Could not save the current files for rollback"
   rm -f "$tarball"
   exit 1
  fi

  date +%s > "$WATCHDOG_PAUSE_FILE" 2>/dev/null || true
  log_msg "Stopping PGenerator..."
  APPLY_STOPPED=1
  /etc/init.d/PGenerator stop 2>/dev/null || true
  sleep 2

  require_writable_path "/" "root filesystem"

  set_update_state installing "Installing $latest"
  log_msg "Extracting update..."
  cd /
  tar xzf "$tarball" 2>&1 | tee -a "$UPDATE_LOG"

  restore_exec_bits "$EXEC_MANIFEST_FILE"

  # A payload built with a widened umask packages these group-writable, and
  # extraction applies that to the live tree. OpenSSH then refuses to start
  # because /var is group-writable, taking SSH down with it.
  chmod 0755 / /etc /lib /usr /var 2>/dev/null || true

  chmod +x /usr/sbin/pgenerator-* 2>/dev/null || true
  chmod +x /usr/sbin/PGeneratord* 2>/dev/null || true
  chmod +x /etc/init.d/PGenerator /etc/init.d/rcPGenerator /etc/init.d/dhcp 2>/dev/null || true
  chmod +x /usr/bin/PGenerator_*.pl 2>/dev/null || true
  chmod +x /usr/bin/pgenerator-* 2>/dev/null || true
  chmod +x /usr/bin/spotread /usr/bin/chartread /usr/bin/colprof /usr/bin/profcheck /usr/bin/targen /usr/bin/applycal /usr/bin/pgsethdr 2>/dev/null || true
  chmod +x /usr/bin/spotread_wrapper.sh 2>/dev/null || true
  chmod +x /usr/bin/meter_*.sh 2>/dev/null || true
  chmod +x /usr/bin/spotread_measure.py 2>/dev/null || true
  chown root:root /etc/sudo/sudoers /etc/sudo/sudoers.d /etc/sudo/sudoers.d/PGenerator /etc/sudoers.d /etc/sudoers.d/PGenerator 2>/dev/null || true
  chmod 755 /etc/sudo /etc/sudo/sudoers.d /etc/sudoers.d 2>/dev/null || true
  chmod 440 /etc/sudo/sudoers /etc/sudo/sudoers.d/PGenerator /etc/sudoers.d/PGenerator 2>/dev/null || true

  merge_conf_defaults

  run_update_migrations "$current" "$latest"

  require_writable_path "/usr/share/PGenerator" "PGenerator install tree"

  rm -f "$tarball"
  sync

  log_msg "Update to $latest extracted — restarting PGenerator..."
  # From here the new files stay: a failed start is reported, not rolled back.
  APPLY_DONE=1
  set_update_state restarting "Starting PGenerator+ $latest"
  if ! /etc/init.d/PGenerator start 2>/dev/null; then
   log_msg "ERROR: PGenerator restart command failed after update"
   echo "ERROR: PGenerator restart failed after update"
   exit 1
  fi

  if ! wait_for_local_api 30; then
   log_msg "ERROR: PGenerator API did not recover after updating to $latest"
   echo "ERROR: PGenerator did not come back after update"
   exit 1
  fi

  set_update_state done "Updated to $latest"
  echo "OK: Updated to $latest"
  ;;

 *)
  echo "Usage: pgenerator-update {check|apply|version}"
  echo ""
  echo "  check    — Check for available updates"
  echo "  apply    — Download and install latest update"
  echo "  version  — Show current version"
  exit 1
  ;;
esac
